---
import '../styles/global.css';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getLogoSrc } from '../utils/logos';

const studies = (await getCollection('case-studies'))
  .sort((a: CollectionEntry<'case-studies'>, b: CollectionEntry<'case-studies'>) =>
    (a.data.order ?? 99) - (b.data.order ?? 99)
  );
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <title>Macklem Media & Brand</title>
  </head>
  <body>

    <!-- Hero panel: always fixed, GSAP scrubs it from center to nav bar -->
    <div id="hero-panel">
      <img id="hero-logo" src="/mmnb_wordmark_black.svg" alt="Macklem Media & Brand" />
      <nav id="nav-links">
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>

    <!-- Hero: b-roll video background -->
    <section id="hero">
      <video id="hero-video" autoplay muted loop playsinline>
        <source src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerFun.mp4" type="video/mp4" />
      </video>
      <p id="hero-tagline"><span style="font-weight:900">Brand</span> and <span style="font-weight:900">media</span> have never been this <span style="font-weight:900;font-size:1.2em">easy</span>.</p>
      <button id="scroll-arrow" aria-label="Scroll down">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </button>
      <button id="scroll-work" aria-label="Scroll to Work">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </button>
    </section>

    <!-- Main: Work, About and Contact -->
    <main>
		
		<!-- Work -->
      <section id="work">
        <h2>Work</h2>
        <div class="work-grid">

          {studies.map((study: CollectionEntry<'case-studies'>) => (
            <a href={`/case-studies/${study.id.replace(/\.mdx?$/, '')}`} class="work-card">
              <div class="work-card-thumb">
                <img src={getLogoSrc(study.data.logo)} alt={study.data.title} />
              </div>
              <div class="work-card-body">
                <p class="tag">{study.data.tags.join(' · ')}</p>
                <h3>{study.data.title}</h3>
                <p set:html={study.data.byline} />
              </div>
            </a>
          ))}

          <a href="/case-studies/project-five" class="work-card">
            <div class="work-card-thumb work-card-thumb--placeholder"></div>
            <div class="work-card-body">
              <p class="tag">Social Media</p>
              <h3>Project Title Five</h3>
              <p>Placeholder description for a social media campaign. Full case study coming soon.</p>
            </div>
          </a>

          <a href="/case-studies/project-six" class="work-card">
            <div class="work-card-thumb work-card-thumb--placeholder"></div>
            <div class="work-card-body">
              <p class="tag">Consulting</p>
              <h3>Project Title Six</h3>
              <p>Placeholder description for a brand consulting engagement. Full case study coming soon.</p>
            </div>
          </a>

        </div>
        <a href="/case-studies" class="all-case-studies-link">All case studies &rarr;</a>
      </section>

      <!-- About -->
      <section id="about">
        <h2>About</h2>
        <div class="about-body">
          <p class="about-lead">Macklem Media &amp; Brand is a full-service agency that is democratizing brand excellence with <strong>AI</strong>.</p>
          <p class="about-sub">We partner with clients to create brand identities, compelling narratives and impactful content affordably at scale. We combine the latest in AI tools with real experience at Canada's top media outlets to deliver the highest results.</p>
        </div>
      </section>

      <!-- Contact -->
      <section id="contact">
        <h2>Contact</h2>
        <div class="contact-body">
          <p class="contact-lead">Interested in working together?</p>
          <a href="mailto:rj@macklem.ca" class="contact-email">rj@macklem.ca</a>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="bg-black text-white px-8" style="display:flex;align-items:center;justify-content:center;padding-top:2rem;padding-bottom:2rem;">
      <div class="max-w-6xl mx-auto w-full flex flex-col items-center justify-center gap-6 text-center">
        <div class="flex gap-6 items-center">
          <!-- LinkedIn -->
          <a href="https://linkedin.com" target="_blank" rel="noopener" aria-label="LinkedIn"
            class="text-white opacity-100 hover:opacity-50 transition-opacity">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
          <!-- YouTube -->
          <a href="https://youtube.com" target="_blank" rel="noopener" aria-label="YouTube"
            class="text-white opacity-100 hover:opacity-50 transition-opacity">
            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
            </svg>
          </a>
        </div>
        <p class="text-sm tracking-widest text-white">
          &copy; 2026 Macklem Media &amp; Brand.
        </p>
      </div>
    </footer>

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // Capture and defer hash navigation from external pages.
      // The browser fires its native hash scroll before GSAP's ScrollTrigger
      // adds its pin spacer, causing an incorrect scroll position. We prevent
      // the native scroll and re-apply it after GSAP has fully initialized.
      const pendingHash = window.location.hash;
      if (pendingHash) {
        window.scrollTo(0, 0);
        history.replaceState(null, '', window.location.pathname);
      }

      // Logo lives inside the panel — only set its horizontal centering
      gsap.set('#hero-panel', { yPercent: -50 });
      gsap.set('#hero-logo', { xPercent: -50, yPercent: -50 });

      // Hero scroll animation: white panel collapses to nav, logo shrinks left
      gsap.timeline({
        scrollTrigger: {
          trigger: '#hero',
          start: 'top top',
          end: '+=700',
          scrub: 5,
          pin: true,
        },
      })
      .to('#hero-panel', {
        top: 0,
        yPercent: 0,
        height: 100,
        ease: 'power2.inOut',
      })
      .to('#hero-logo', {
        width: 200,
        left: 42,
        xPercent: 0,
        ease: 'power2.inOut',
      }, '<')
      .to(
        '#nav-links',
        { opacity: 1, ease: 'power2.in' },
        '>-0.3'
      )
      .to(
        '#hero-tagline',
        { opacity: 1, ease: 'power2.in' },
        0.1
      );

      // Fade arrow in on load, then pulse; GSAP owns opacity throughout
      const arrow = document.getElementById('scroll-arrow');
      let pulseTween: gsap.core.Animation | null = null;

      const startPulse = () => {
        if (!arrowVisible) return; // guard: don't restart if already fading out
        const tl = gsap.timeline({ repeat: -1 });
        tl.fromTo(arrow, { opacity: 1 }, { opacity: 0.25, duration: 1.2, ease: 'sine.inOut' })
          .fromTo(arrow, { opacity: 0.25 }, { opacity: 1, duration: 1.2, ease: 'sine.inOut' });
        pulseTween = tl;
      };

      const fadeOutArrow = () => {
        if (!arrowVisible) return;
        arrowVisible = false;
        pulseTween?.kill();
        gsap.to(arrow, { opacity: 0, duration: 0.3, overwrite: true, onComplete: () => {
          if (arrow) arrow.style.pointerEvents = 'none';
        }});
      };

      gsap.to(arrow, { opacity: 1, duration: 0.8, delay: 0.5, onComplete: startPulse });

      // ── Second scroll button (scroll to Work) ──────────
      const workBtn = document.getElementById('scroll-work');
      let workBtnVisible = false;
      let workPulseTween: gsap.core.Animation | null = null;

      const startWorkPulse = () => {
        if (!workBtnVisible) return;
        const tl = gsap.timeline({ repeat: -1 });
        tl.fromTo(workBtn, { opacity: 1 }, { opacity: 0.25, duration: 1.2, ease: 'sine.inOut' })
          .fromTo(workBtn, { opacity: 0.25 }, { opacity: 1, duration: 1.2, ease: 'sine.inOut' });
        workPulseTween = tl;
      };

      const showWorkBtn = () => {
        if (workBtnVisible) return;
        workBtnVisible = true;
        if (workBtn) workBtn.style.pointerEvents = 'auto';
        gsap.to(workBtn, { opacity: 1, duration: 0.4, overwrite: true, onComplete: startWorkPulse });
      };

      const hideWorkBtn = () => {
        if (!workBtnVisible) return;
        workBtnVisible = false;
        workPulseTween?.kill();
        gsap.to(workBtn, { opacity: 0, duration: 0.3, overwrite: true, onComplete: () => {
          if (workBtn) workBtn.style.pointerEvents = 'none';
        }});
      };

      let isScrollingToWork = false;

      workBtn?.addEventListener('click', () => {
        hideWorkBtn();
        const workEl = document.getElementById('work');
        if (!workEl) return;
        const target = workEl.getBoundingClientRect().top + window.scrollY;
        const start = { y: window.scrollY };
        document.documentElement.style.scrollBehavior = 'auto';
        isScrollingToWork = true;
        gsap.to(start, {
          y: target,
          duration: 1.5,
          ease: 'power2.inOut',
          onUpdate() { window.scrollTo(0, start.y); },
          onComplete() {
            document.documentElement.style.scrollBehavior = '';
            isScrollingToWork = false;
          },
        });
      });

      // ── Shared scroll listener ───────────────────────
      let arrowVisible = true;
      window.addEventListener('scroll', () => {
        const sy = window.scrollY;

        // First arrow: visible only at top
        if (arrowVisible && sy > 10) {
          fadeOutArrow();
        } else if (!arrowVisible && sy <= 10) {
          arrowVisible = true;
          if (arrow) arrow.style.pointerEvents = 'auto';
          gsap.to(arrow, { opacity: 1, duration: 0.4, overwrite: true, onComplete: startPulse });
        }

        // Second button: show when animation done, hide only when well back into the animation
        if (!workBtnVisible && sy >= 680 && !isScrollingToWork) {
          showWorkBtn();
        } else if (workBtnVisible && sy < 450) {
          hideWorkBtn();
        }
      }, { passive: true });

      // Click first arrow: fade out immediately then jump scroll
      arrow?.addEventListener('click', () => {
        fadeOutArrow();
        window.scrollTo(0, 700);
      });

      // Scroll to deferred hash now that GSAP pin spacers are in place
      if (pendingHash) {
        const target = document.querySelector(pendingHash);
        if (target) {
          const y = target.getBoundingClientRect().top + window.scrollY - 100;
          window.scrollTo(0, Math.max(0, y));
        }
      }
    </script>

  </body>
</html>
